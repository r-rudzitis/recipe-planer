<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container" style="display:flex; justify-content:center; align-items:center; min-height:calc(100vh - 58px - 10rem);">
    <div class="section-card" style="text-align:center; max-width:480px; width:100%; padding:3rem 2.5rem;">
        <h2 style="margin-bottom:0.5rem;"><%= title %></h2>
        <p style="color:var(--muted); margin-bottom:2rem;"><%= message %></p>
        <a href="<%= backHref || '/' %>" class="btn"><%= backLabel || 'Go home' %></a>
    </div>
</div>
</body>
</html>
